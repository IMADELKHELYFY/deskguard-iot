{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": true,
        "live": {
          ".write": true,
          ".validate": "newData.hasChildren(['ts', 'distance', 'state'])"
        },
        "history": {
          ".indexOn": ["ts"],
          "$entry": {
            ".write": "!data.exists()",
            ".validate": "newData.hasChildren(['ts', 'distance', 'state'])"
          }
        },
        "config": {
          ".write": true,
          ".validate": "newData.hasChildren(['distMin', 'proxDelayS', 'imbalancePct', 'luxCal', 'lightDelayS', 'pauseMin', 'sendPeriodS'])",
          "distMin":      { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 150" },
          "proxDelayS":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120" },
          "imbalancePct": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 95" },
          "luxCal":       { ".validate": "newData.isNumber() && newData.val() >= 0.1 && newData.val() <= 10" },
          "lightDelayS":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120" },
          "pauseMin":     { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 240" },
          "sendPeriodS":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "telegramOn":   { ".validate": "newData.isBoolean()" },
          "$other":       { ".validate": false }
        },
        "telegram": {
          ".write": true,
          ".validate": "newData.hasChildren(['status', 'phoneHash'])",
          "phoneHash":  { ".validate": "newData.isString() && newData.val().length === 64" },
          "phoneLast2": { ".validate": "newData.isString() && newData.val().length <= 2" },
          "code":       { ".validate": "newData.isString() && newData.val().length <= 12" },
          "status":     { ".validate": "newData.val() === 'pending' || newData.val() === 'verified' || newData.val() === 'failed'" },
          "chatId":     { ".validate": "newData.isNumber()" },
          "$other":     { ".validate": false }
        },
        "telegramBot": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length <= 64"
        }
      }
    }
  }
}
